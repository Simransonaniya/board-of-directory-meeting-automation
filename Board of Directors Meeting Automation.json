{
  "name": "Board of Directors Meeting Automation",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Schedule a Board of Directors Meeting",
        "formDescription": "Fill in the meeting details. An AI-drafted formal notice and agenda will be sent to the Chairperson for approval before going out to the directors.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Company Name",
              "fieldName": "company_name",
              "requiredField": true
            },
            {
              "fieldLabel": "Meeting Title",
              "fieldName": "meeting_title",
              "placeholder": "e.g. Q3 Board Meeting",
              "requiredField": true
            },
            {
              "fieldLabel": "Meeting Type",
              "fieldType": "dropdown",
              "fieldName": "meeting_type",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Regular Board Meeting"
                  },
                  {
                    "option": "Special / Emergency Board Meeting"
                  },
                  {
                    "option": "Annual General Meeting"
                  },
                  {
                    "option": "Committee Meeting"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Meeting Date",
              "fieldType": "date",
              "fieldName": "meeting_date",
              "requiredField": true
            },
            {
              "fieldLabel": "Start Time (IST)",
              "fieldName": "meeting_time",
              "placeholder": "e.g. 14:30 or 2:30 PM",
              "requiredField": true
            },
            {
              "fieldLabel": "Duration (hours)",
              "fieldType": "number",
              "fieldName": "duration_hours",
              "defaultValue": "2",
              "requiredField": true
            },
            {
              "fieldLabel": "Venue or Video Link",
              "fieldName": "venue",
              "placeholder": "Boardroom, 5th floor / Google Meet link",
              "requiredField": true
            },
            {
              "fieldLabel": "Directors Emails",
              "fieldType": "textarea",
              "fieldName": "directors_emails",
              "placeholder": "Comma-separated email addresses",
              "requiredField": true
            },
            {
              "fieldLabel": "Chairperson Email (approver)",
              "fieldType": "email",
              "fieldName": "chair_email",
              "requiredField": true
            },
            {
              "fieldLabel": "Company Secretary Email",
              "fieldType": "email",
              "fieldName": "secretary_email",
              "requiredField": true
            },
            {
              "fieldLabel": "Agenda Topics",
              "fieldType": "textarea",
              "fieldName": "agenda_topics",
              "placeholder": "One topic per line",
              "requiredField": true
            },
            {
              "fieldLabel": "Background Notes (optional)",
              "fieldType": "textarea",
              "fieldName": "background_notes",
              "placeholder": "Context, financial highlights, previous decisions..."
            }
          ]
        },
        "options": {
          "buttonLabel": "Submit for Approval",
          "path": "board-meeting",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thank you. The draft meeting notice has been sent to the Chairperson for approval."
            }
          }
        }
      },
      "id": "f0eb9310-6aa3-4dac-aa8b-ca782e2c2976",
      "name": "Board Meeting Request Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        -160,
        112
      ],
      "webhookId": "748b0659-04c9-4e55-a1c8-f3429b95f2e6"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "start",
              "name": "meeting_start",
              "type": "string",
              "value": "={{ (() => { const d = String($json.meeting_date).slice(0,10); const t = String($json.meeting_time).trim().toUpperCase().replace(/\\./g, ':'); const z = { zone: 'Asia/Kolkata' }; const fmts = ['HH:mm', 'H:mm', 'h:mm a', 'h:mma', 'h a', 'ha']; for (const f of fmts) { const dt = DateTime.fromFormat(d + ' ' + t, 'yyyy-MM-dd ' + f, z); if (dt.isValid) return dt.toISO(); } return DateTime.fromISO(d, z).set({ hour: 10 }).toISO(); })() }}"
            },
            {
              "id": "emails",
              "name": "directors_list",
              "type": "string",
              "value": "={{ String($json.directors_emails).split(/[,;\\n]+/).map(e => e.trim()).filter(e => e.includes('@')).join(', ') }}"
            },
            {
              "id": "ref",
              "name": "meeting_ref",
              "type": "string",
              "value": "=BM-{{ $now.toFormat('yyyyMMdd') }}-{{ $execution.id }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "ed51ef78-0765-4879-9a98-11c761d686ba",
      "name": "Prepare Meeting Details",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        112
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "pretty",
              "name": "meeting_when",
              "type": "string",
              "value": "={{ DateTime.fromISO($json.meeting_start).setZone('Asia/Kolkata').toFormat(\"cccc, d LLLL yyyy 'at' h:mm a\") }} IST"
            },
            {
              "id": "rem",
              "name": "reminder_at",
              "type": "string",
              "value": "={{ DateTime.max(DateTime.fromISO($json.meeting_start).minus({ hours: 24 }), $now.plus({ minutes: 5 })).toISO() }}"
            },
            {
              "id": "end",
              "name": "meeting_end",
              "type": "string",
              "value": "={{ DateTime.fromISO($json.meeting_start).plus({ hours: Number($json.duration_hours) || 2 }).toISO() }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "5313dc06-27eb-4e3f-ba79-7ca9897dddaf",
      "name": "Compute Schedule",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        448,
        112
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Draft a formal notice and agenda for a board meeting.\n\nCompany: {{ $json.company_name }}\nMeeting reference: {{ $json.meeting_ref }}\nTitle: {{ $json.meeting_title }}\nType: {{ $json.meeting_type }}\nDate and time: {{ $json.meeting_when }}\nDuration: {{ $json.duration_hours }} hours\nVenue / link: {{ $json.venue }}\nAgenda topics (one per line):\n{{ $json.agenda_topics }}\nBackground notes: {{ $json.background_notes || 'None' }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are an experienced Company Secretary. Write a professional, legally sound board meeting notice in clean HTML (inline styles only, no <html>/<head>/<body> tags, no markdown, no code fences). Include: a heading with company name and meeting reference; date, time, venue; a numbered agenda that always starts with standard items (Call to order and quorum check, Leave of absence, Approval of previous minutes, Declaration of conflicts of interest), followed by the provided topics each with a one-line purpose and a suggested time allocation that fits the duration, and ends with Any other business and Closing; a short \"Preparation required\" section; and a polite request to confirm attendance. Sign off as \"Company Secretary\"."
            }
          ]
        },
        "batching": {}
      },
      "id": "3ffc2bf4-dd6d-4d31-9716-8b51201fa665",
      "name": "Draft Notice and Agenda",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        672,
        112
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {}
      },
