    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "={{ $('Compute Schedule').item.json.chair_email }}",
        "subject": "=Approval needed: {{ $('Compute Schedule').item.json.meeting_title }} notice ({{ $('Compute Schedule').item.json.meeting_ref }})",
        "message": "=Dear Chairperson,<br><br>Please review the draft notice below for <b>{{ $('Compute Schedule').item.json.meeting_title }}</b> on {{ $('Compute Schedule').item.json.meeting_when }}. Once approved it will be sent to: {{ $('Compute Schedule').item.json.directors_list }}.<br><hr>{{ $json.text.replace(/```html|```/g, '') }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve and Send",
            "disapproveLabel": "Reject"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "resumeAmount": 2,
              "resumeUnit": "days"
            }
          },
          "appendAttribution": false
        }
      },
