    {
      "parameters": {
        "promptType": "define",
        "text": "=Prepare formal minutes for this board meeting.\n\nCompany: {{ $('Compute Schedule').item.json.company_name }}\nReference: {{ $('Compute Schedule').item.json.meeting_ref }}\nTitle: {{ $('Compute Schedule').item.json.meeting_title }} ({{ $('Compute Schedule').item.json.meeting_type }})\nHeld on: {{ $('Compute Schedule').item.json.meeting_when }}\nVenue: {{ $('Compute Schedule').item.json.venue }}\nPlanned agenda:\n{{ $('Compute Schedule').item.json.agenda_topics }}\n\nSecretary's submitted notes (JSON):\n{{ JSON.stringify($json.data || $json) }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are an experienced Company Secretary. Produce formal board minutes in clean HTML (inline styles only, no <html>/<head>/<body>, no markdown, no code fences). Sections: header (company, reference, date, venue); Attendance (present, apologies, quorum statement); numbered Minutes per agenda item summarising discussion; Resolutions passed, each phrased \"RESOLVED THAT ...\"; an Action Items HTML table with columns #, Action, Owner, Due Date, Status (Open) - infer owners and dates only from the notes, otherwise write \"TBD\"; Next steps; and a signature block for Chairperson and Company Secretary marked \"Draft - subject to approval at the next meeting\". Do not invent facts not present in the notes."
            }
          ]
        },
        "batching": {}
